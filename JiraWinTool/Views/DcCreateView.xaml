<UserControl x:Class="JiraWinTool.Views.DcCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:JiraWinTool.Views.Controls"
             x:Name="Root">
    <DockPanel Margin="20">
        <!-- 页头 -->
        <controls:PageHeader DockPanel.Dock="Top" x:Name="Header"
            Title="创建 DC"
            Subtitle="扫描本地目录中 REQ- 开头的子目录，参考模板 DC 批量创建『生产数据配置变更申请』"
            Icon="🗂️" HeaderColor="#0EA5E9"/>

        <!-- 目录与模板 -->
        <Border DockPanel.Dock="Top" CornerRadius="12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                Padding="16" Margin="0,12,0,12">
            <StackPanel>
                <TextBlock Text="本地目录与模板" FontSize="14" FontWeight="SemiBold" Foreground="#0EA5E9" Margin="0,0,0,12"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="选择目录..." Width="100" Height="28" Margin="8,0,0,0"
                            Background="#E5E7EB" Foreground="#374151" BorderThickness="0"
                            FontSize="12" Cursor="Hand" Click="BrowseDir_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <controls:LabeledField Label="本地目录"
                        Placeholder="选择包含 REQ-xxxxx 子目录的根目录"
                        Text="{Binding RootDir, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                        LabelWidth="90"/>
                </DockPanel>
                <controls:LabeledField Label="SVN前置地址"
                    Placeholder="如 http://svn.sinosafe.com.cn:1580/svn/NEWPCIS/DC/2026（拼接目录名作为 SVN 地址；留空则用本地目录）"
                    Text="{Binding SvnBase, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                    LabelWidth="90"/>
                <controls:LabeledField Label="模板 DC"
                    Placeholder="如 DC-123（用作字段参考；首次填入后自动保存）"
                    Text="{Binding TemplateDcKey, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                    LabelWidth="90"/>
                <controls:LabeledField Label="变更原因"
                    Placeholder="留空则复制模板 DC 的变更原因；填写后覆盖写入新建 DC"
                    Text="{Binding FixedChangeReason, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                    LabelWidth="90"/>
                <controls:LabeledField Label="标签"
                    Placeholder="如『数据变更』，多个用英文逗号分隔"
                    Text="{Binding FixedLabels, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                    LabelWidth="90"/>
                <controls:LabeledField Label="经办人"
                    Placeholder="登录账号"
                    Text="{Binding FixedAssignee, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                    LabelWidth="90"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="测试附件" Width="90" VerticalAlignment="Center" FontSize="13" Foreground="#374151"/>
                    <TextBlock Text="{Binding TestAttachDisplay, ElementName=Root}" VerticalAlignment="Center"
                               FontSize="12" Foreground="#64748B" Margin="4,0,8,0" MaxWidth="400" TextTrimming="CharacterEllipsis"/>
                    <Button Content="选择文件..." Width="100" Height="30"
                            Background="#E5E7EB" Foreground="#374151" BorderThickness="0"
                            FontSize="12" Cursor="Hand" Click="BrowseTestFile_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="清除" Width="60" Height="30" Margin="6,0,0,0"
                            Background="#E5E7EB" Foreground="#374151" BorderThickness="0"
                            FontSize="12" Cursor="Hand" Click="ClearTestFile_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="ScanBtn" Content="扫描目录" Width="110" Height="34"
                            Background="#0EA5E9" Foreground="White" BorderThickness="0"
                            FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                            Click="ScanBtn_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <TextBlock x:Name="ScanProgress" Text="" Foreground="#0EA5E9"
                               VerticalAlignment="Center" Margin="12,0,0,0" FontSize="13"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 执行区（底部） -->
        <Border DockPanel.Dock="Bottom" CornerRadius="12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                Padding="16" Margin="0,0,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="CreateBtn" Content="批量创建 DC" Width="130" Height="34"
                            Background="#22C55E" Foreground="White" BorderThickness="0"
                            FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                            Click="CreateBtn_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="清空" Width="80" Height="34" Margin="8,0,0,0"
                            Background="#E5E7EB" Foreground="#374151" BorderThickness="0"
                            FontSize="13" Cursor="Hand" Click="ClearBtn_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="OpenBtn" Content="打开 DC" Width="110" Height="34" Margin="8,0,0,0"
                            Background="#3B82F6" Foreground="White" BorderThickness="0"
                            FontSize="13" Cursor="Hand" Click="OpenBtn_Click" Visibility="Collapsed">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <TextBlock x:Name="CreateProgress" Text="" Foreground="#22C55E"
                               VerticalAlignment="Center" Margin="12,0,0,0" FontSize="13"/>
                </StackPanel>
                <controls:LogView x:Name="LogViewControl" Logs="{Binding Logs, ElementName=Root}" Height="160"/>
            </StackPanel>
        </Border>

        <!-- 扫描结果列表 -->
        <Border CornerRadius="12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                Padding="8" Margin="0,0,0,12" MinHeight="180">
            <Grid>
                <TextBlock x:Name="NoItemHint" Text="尚未扫描。选择本地目录后点击『扫描目录』，将列出 REQ- 开头的子目录，并按文件名末尾的系统名拆分（每个系统一个 DC，摘要=目录名+系统名，变更内容汇总该系统文件）。"
                           FontSize="12" Foreground="#888888" Margin="8" TextWrapping="Wrap"
                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <DataGrid x:Name="ItemList" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="Transparent" BorderThickness="0"
                          RowHeaderWidth="0" SelectionMode="Single"
                          FontSize="12" MinRowHeight="36">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" Click="SelectAll_Click" Tag="all"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="目录 / REQ" Width="110" IsReadOnly="True"
                                            Binding="{Binding DirectoryDisplay}"/>
                        <DataGridTextColumn Header="系统" Width="170" IsReadOnly="True"
                                            Binding="{Binding SystemDisplay}"/>
                        <DataGridTextColumn Header="SVN地址" Width="200" IsReadOnly="True"
                                            Binding="{Binding SvnUrl}"/>
                        <DataGridTextColumn Header="摘要（可修改）" Width="200"
                                            Binding="{Binding Summary, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTemplateColumn Header="变更内容（可修改）" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" MaxHeight="80"
                                             BorderThickness="0" Background="Transparent"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="上传附件（勾选文件）" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Files}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsAttachment, UpdateSourceTrigger=PropertyChanged}"
                                                              Margin="0,1">
                                                        <TextBlock FontSize="11">
                                                            <Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding SizeDisplay, Mode=OneWay}" Foreground="#888888"/>
                                                        </TextBlock>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridCheckBoxColumn Header="关联REQ" Width="70"
                                                Binding="{Binding LinkReq, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="状态" Width="110" IsReadOnly="True"
                                            Binding="{Binding Status, Mode=OneWay}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
