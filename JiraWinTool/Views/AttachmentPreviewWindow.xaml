<Window x:Class="JiraWinTool.Views.AttachmentPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="附件预览" Width="900" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="#FAFAFA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Padding="16,10" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Background="#F5F5F5">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="IconText" Text="📄" Foreground="#007AFF" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FilenameText" Text="" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                               MaxWidth="600"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OpenExternalButton" Content="🌐 外部打开" Padding="10,4" Margin="0,0,8,0"
                            Visibility="Collapsed" Click="OpenExternal_Click"/>
                    <Button Content="关闭" Padding="12,4" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区 -->
        <Grid Grid.Row="1">
            <!-- 图片预览 -->
            <ScrollViewer x:Name="ImagePanel" Visibility="Collapsed"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="PreviewImage" Margin="16" Stretch="None"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </ScrollViewer>

            <!-- 文本预览 -->
            <TextBox x:Name="TextPanel" Visibility="Collapsed" Style="{StaticResource LogTextBox}"
                     BorderThickness="0" Padding="16"/>

            <!-- RTF 富文本预览 -->
            <RichTextBox x:Name="RtfPanel" Visibility="Collapsed" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" Padding="16" BorderThickness="0"/>

            <!-- 无法内嵌预览（PDF / Word）：保存临时文件并外部打开 -->
            <StackPanel x:Name="ExternalPanel" Visibility="Collapsed" HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="📄" FontSize="40" HorizontalAlignment="Center" Foreground="#888888"/>
                <TextBlock x:Name="ExternalHintText" Text="此文件类型暂不支持内嵌预览" Foreground="#888888"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <Button Content="使用系统默认程序打开" Padding="16,6" Margin="0,14,0,0"
                        HorizontalAlignment="Center" Click="OpenExternal_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
