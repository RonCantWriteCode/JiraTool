<UserControl x:Class="JiraWinTool.Views.VersionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:JiraWinTool.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <controls:PageHeader Title="版本管理" Subtitle="创建或删除 Jira REQ 项目版本号" Icon="🏷️"
                                 HeaderColor="#5856D6" Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="CreateModeRadio" Content="创建版本号" GroupName="Mode" IsChecked="True" Margin="0,0,16,0"
                             Checked="ModeChanged"/>
                <RadioButton x:Name="DeleteModeRadio" Content="删除版本号" GroupName="Mode" Checked="ModeChanged"/>
            </StackPanel>

            <!-- Create Mode -->
            <StackPanel x:Name="CreatePanel">
                <controls:LabeledField Label="日期:" Placeholder="yyyy-MM-dd" x:Name="DateField"/>

                <CheckBox x:Name="IsUrgentCheck" Content="紧急版本" Margin="0,8,0,8"/>

                <TextBlock Text="选择系统:" FontWeight="Bold" Margin="0,8,0,4"/>
                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8">
                    <WrapPanel x:Name="SystemsPanel"/>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="全选" Height="28" Padding="8,0" Click="SelectAllButton_Click"/>
                    <Button Content="清空" Height="28" Margin="8,0,0,0" Padding="8,0" Click="ClearSelectionButton_Click"/>
                </StackPanel>

                <Separator Margin="0,16,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="批量创建常规版本:" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="常规版本日期管理" Height="28" Margin="16,0,0,0" Padding="10,0" Click="DateManagerButton_Click"/>
                </StackPanel>
                <Button Content="批量创建" Height="30" Padding="12,0" HorizontalAlignment="Left"
                        Click="BatchCreateButton_Click"/>
            </StackPanel>

            <!-- Delete Mode -->
            <StackPanel x:Name="DeletePanel" Visibility="Collapsed">
                <controls:LabeledField Label="版本号名称:" Placeholder="如: CLM_V10_26.4.21" x:Name="DeleteVersionField"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="ExecuteButton" Content="执行" MinWidth="80" Height="30" Click="ExecuteButton_Click"/>
                <Button Content="清空日志" Height="30" Margin="12,0,0,0" Padding="10,0" Click="ClearButton_Click"/>
                <Button Content="复制结果" Height="30" Margin="12,0,0,0" Padding="10,0" Click="CopyButton_Click"/>
            </StackPanel>

            <controls:LogView x:Name="LogViewControl" MinHeight="200" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
