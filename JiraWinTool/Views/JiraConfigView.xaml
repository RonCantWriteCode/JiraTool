<UserControl x:Class="JiraWinTool.Views.JiraConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="680">

            <!-- Jira 服务器配置 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Jira 服务器配置" Style="{StaticResource CardTitle}"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Jira URL" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="UrlBox" Grid.Column="1" Height="28" VerticalContentAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="用户名" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="UserBox" Grid.Column="1" Height="28" VerticalContentAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="密码" Style="{StaticResource FormLabel}"/>
                        <PasswordBox x:Name="PasswordBox" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                                     PasswordChanged="PasswordBox_PasswordChanged" KeyDown="Password_KeyDown"/>
                        <TextBox x:Name="PasswordTextBox" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                                 Visibility="Collapsed" TextChanged="PasswordTextBox_TextChanged" KeyDown="Password_KeyDown"/>
                        <Button Grid.Column="2" Content="👁" Width="32" Height="28" Margin="6,0,0,0"
                                ToolTip="显示/隐藏密码" Click="TogglePasswordVisibility_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 会话状态 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="会话状态" Style="{StaticResource CardTitle}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse x:Name="SessionDot" Width="10" Height="10" Fill="Red" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SessionStatusText" Text="未登录" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock x:Name="SessionUserText" Text="" Foreground="#888888"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="SessionTimePanel" Visibility="Collapsed">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="登录时间:" Foreground="#666666"/>
                            <TextBlock x:Name="LoginTimeText" Grid.Column="1" Foreground="#888888" Margin="8,0,0,0"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="过期时间:" Foreground="#666666"/>
                            <TextBlock x:Name="ExpireTimeText" Grid.Column="1" Foreground="#888888" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="LoginButton" Content="登录" Width="80" Height="30" Click="Login_Click"/>
                        <Button x:Name="LogoutButton" Content="登出" Width="80" Height="30" Margin="10,0,0,0"
                                Visibility="Collapsed" Click="Logout_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="TestResultText" Text="" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 快捷操作 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="快捷操作" Style="{StaticResource CardTitle}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="保存密码" Width="90" Height="30" Click="SavePassword_Click"/>
                        <Button x:Name="TestButton" Content="测试连接" Width="90" Height="30" Margin="10,0,0,0"
                                Click="TestConnection_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="SaveResultText" Text="" Foreground="Green" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 当前配置 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="当前配置" Style="{StaticResource CardTitle}"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="URL:" Foreground="#666666"/>
                        <TextBlock x:Name="CurrentUrlText" Grid.Column="1" Foreground="#888888" Margin="8,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="用户:" Foreground="#666666"/>
                        <TextBlock x:Name="CurrentUserText" Grid.Column="1" Foreground="#888888" Margin="8,0,0,0"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="密码:" Foreground="#666666"/>
                        <TextBlock x:Name="CurrentPasswordText" Grid.Column="1" Foreground="#888888" Margin="8,0,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
