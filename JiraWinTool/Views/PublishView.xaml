<UserControl x:Class="JiraWinTool.Views.PublishView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:JiraWinTool.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <controls:PageHeader Title="创建发布申请" Subtitle="按日期批量创建或按 REQ 单独创建 PUBLISH 工单" Icon="🚀"
                                 HeaderColor="#007AFF" Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="DateModeRadio" Content="按日期创建" GroupName="Mode" IsChecked="True" Margin="0,0,16,0"
                             Checked="ModeChanged"/>
                <RadioButton x:Name="ReqModeRadio" Content="按REQ创建" GroupName="Mode" Checked="ModeChanged"/>
            </StackPanel>

            <!-- Date Mode -->
            <StackPanel x:Name="DatePanel">
                <controls:LabeledField Label="发布日期:" Placeholder="yyyy-MM-dd" x:Name="DateField"/>
                <controls:LabeledField Label="排除版本号:" Placeholder="可选，指定不创建的版本号" x:Name="NoPublishIdField"/>
            </StackPanel>

            <!-- REQ Mode -->
            <StackPanel x:Name="ReqPanel" Visibility="Collapsed">
                <controls:LabeledField Label="REQ ID:" Placeholder="REQ-XXXXX" x:Name="ReqIdField"/>
                <controls:LabeledField Label="指定版本号:" Placeholder="可选，空则创建全部" x:Name="BanBenHaoField"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="ExecuteButton" Content="执行" MinWidth="80" Height="30" Click="ExecuteButton_Click"/>
                <Button Content="清空日志" Height="30" Margin="12,0,0,0" Padding="10,0" Click="ClearButton_Click"/>
                <Button Content="复制结果" Height="30" Margin="12,0,0,0" Padding="10,0" Click="CopyButton_Click"/>
            </StackPanel>

            <controls:LogView x:Name="LogViewControl" MinHeight="200" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
