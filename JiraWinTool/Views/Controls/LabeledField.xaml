<UserControl x:Class="JiraWinTool.Views.Controls.LabeledField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label, ElementName=Root}" Style="{StaticResource FormLabel}"
                   Width="{Binding LabelWidth, ElementName=Root}"/>
        <Grid Grid.Column="1">
            <TextBox x:Name="Box" Height="28" VerticalContentAlignment="Center"
                     Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{Binding Placeholder, ElementName=Root}" Foreground="#AAAAAA"
                       Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Visibility="{Binding IsPlaceholderVisible, ElementName=Root}"/>
        </Grid>
    </Grid>
</UserControl>
