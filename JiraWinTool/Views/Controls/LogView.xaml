<UserControl x:Class="JiraWinTool.Views.Controls.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border CornerRadius="12" Background="#80F7F7F7" BorderBrush="#4D000000" BorderThickness="1">
        <Grid>
            <!-- 空态占位 -->
            <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⌨" FontSize="24" Foreground="#80888888" HorizontalAlignment="Center"/>
                <TextBlock Text="执行结果将在此显示..." FontFamily="Consolas" FontSize="13"
                           Foreground="#888888" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
            <!-- 日志内容 -->
            <TextBox x:Name="LogBox" Style="{StaticResource LogTextBox}" BorderThickness="0"
                     Background="Transparent" Padding="16" Visibility="Collapsed"/>
        </Grid>
    </Border>
</UserControl>
