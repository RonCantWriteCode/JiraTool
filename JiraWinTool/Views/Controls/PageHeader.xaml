<UserControl x:Class="JiraWinTool.Views.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Border x:Name="IconBox" Width="48" Height="48" CornerRadius="12" VerticalAlignment="Top">
            <Border.Effect>
                <DropShadowEffect x:Name="IconShadow" BlurRadius="8" ShadowDepth="4" Opacity="0.3"/>
            </Border.Effect>
            <TextBlock x:Name="IconText" Text="📄" FontSize="20" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="SubtitleText" Text="" FontSize="13" Foreground="#888888" Margin="0,4,0,0"/>
        </StackPanel>
    </StackPanel>
</UserControl>
