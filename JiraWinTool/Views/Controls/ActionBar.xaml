<UserControl x:Class="JiraWinTool.Views.Controls.ActionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">
        <Button x:Name="ExecuteButton" MinWidth="100" Height="30" Padding="12,0"
                Click="ExecuteButton_Click">
            <StackPanel Orientation="Horizontal">
                <ProgressBar x:Name="LoadingBar" Width="14" Height="14" IsIndeterminate="True"
                             VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="ExecuteText" Text="执行" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <Button x:Name="ClearButton" Content="🗑 清空" Height="30" Margin="12,0,0,0" Padding="10,0"
                Click="ClearButton_Click"/>
        <Button x:Name="CopyButton" Content="📄 复制" Height="30" Margin="12,0,0,0" Padding="10,0"
                Click="CopyButton_Click"/>
    </StackPanel>
</UserControl>
