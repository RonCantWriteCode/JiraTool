<UserControl x:Class="JiraWinTool.Views.UpdateFieldView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:JiraWinTool.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <controls:PageHeader Title="字段更新" Subtitle="根据预计修复时间批量更新 Jira 字段" Icon="🔄"
                                 HeaderColor="#FF9500" Margin="0,0,0,16"/>

            <controls:LabeledField Label="日期:" Placeholder="yyyy-MM-dd" x:Name="DateField"/>

            <CheckBox x:Name="IsRegularCheck" Content="设置常规版本排期需求为&quot;是&quot;" IsChecked="True" Margin="0,8,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="ExecuteButton" Content="执行更新" MinWidth="80" Height="30" Click="ExecuteButton_Click"/>
                <Button Content="清空日志" Height="30" Margin="12,0,0,0" Padding="10,0" Click="ClearButton_Click"/>
                <Button Content="复制结果" Height="30" Margin="12,0,0,0" Padding="10,0" Click="CopyButton_Click"/>
            </StackPanel>

            <controls:LogView x:Name="LogViewControl" MinHeight="200" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
