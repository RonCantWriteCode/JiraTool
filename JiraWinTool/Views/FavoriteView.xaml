<UserControl x:Class="JiraWinTool.Views.FavoriteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:JiraWinTool.Views.Controls">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部:添加收藏 -->
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <TextBlock Text="收藏 Jira" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="BatchToggleButton" Content="☰ 批量导入" HorizontalAlignment="Right"
                            Padding="10,4" Click="BatchToggle_Click" Background="Transparent"
                            BorderBrush="#40000000" BorderThickness="1"/>
                </Grid>

                <!-- 单行添加模式 -->
                <Grid x:Name="SinglePanel" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="InputBox" Height="30" VerticalContentAlignment="Center"
                                 TextChanged="InputBox_TextChanged" KeyDown="InputBox_KeyDown"/>
                        <TextBlock Text="输入 Jira 链接或编号，如 REQ-22411" Foreground="#AAAAAA"
                                   Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   x:Name="InputPlaceholder"/>
                    </Grid>
                    <Button x:Name="AddButton" Grid.Column="1" Content="添加" Width="80" Height="30"
                            Margin="8,0,0,0" Click="Add_Click"/>
                </Grid>

                <!-- 批量导入模式 -->
                <StackPanel x:Name="BatchPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBox x:Name="BatchInputBox" MinHeight="100" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8"/>
                    <Grid Margin="0,6,0,0">
                        <TextBlock Text="每行一个 Jira 编号或链接" FontSize="12" Foreground="#888888"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="BatchAddButton" Content="批量添加" Width="90" Height="28"
                                HorizontalAlignment="Right" Click="Add_Click"/>
                    </Grid>
                </StackPanel>

                <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- 搜索栏 + 归档切换 -->
        <Border Margin="0,0,0,12" Padding="12,8" Background="#F7F7F7" BorderBrush="#22000000"
                BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔍" Foreground="#888888" VerticalAlignment="Center"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" Height="26" Margin="8,0,0,0"
                         VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent"
                         TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="ArchiveFilter" Grid.Column="2" Width="130" Height="26" Margin="16,0,0,0"
                          VerticalContentAlignment="Center" SelectionChanged="ArchiveFilter_Changed">
                    <ComboBoxItem x:Name="UnarchivedItem" Content="未归档 (0)" Tag="false" IsSelected="True"/>
                    <ComboBoxItem x:Name="ArchivedItem" Content="已归档 (0)" Tag="true"/>
                </ComboBox>
                <TextBlock x:Name="CountText" Grid.Column="3" Margin="12,0,0,0" Foreground="#888888"
                           FontSize="12" VerticalAlignment="Center" Text="0 条"/>
                <Button x:Name="ExportButton" Grid.Column="4" Content="📤 导出" Margin="12,0,0,0"
                        Padding="10,3" ToolTip="导出当前列表为 Excel" Click="Export_Click"/>
            </Grid>
        </Border>

        <!-- 收藏列表 -->
        <Grid Grid.Row="2">
            <!-- 空态：无收藏 -->
            <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="⭐" FontSize="40" HorizontalAlignment="Center" Foreground="#888888"/>
                <TextBlock Text="暂无收藏" Foreground="#888888" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Text="输入 Jira 链接或编号来添加收藏" Foreground="#AAAAAA" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
            <!-- 空态：搜索无匹配 -->
            <TextBlock x:Name="NoMatchText" Visibility="Collapsed" Foreground="#888888"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <ListView x:Name="FavList" BorderThickness="0" Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="RowBorder" Padding="10,6" CornerRadius="6" Background="White"
                                BorderBrush="#1A000000" BorderThickness="1">
                            <Border.ContextMenu>
                                <ContextMenu Opened="RowContextMenu_Opened">
                                    <MenuItem Header="在浏览器中打开" Click="CtxOpen_Click"/>
                                    <MenuItem Header="复制编号" Click="CtxCopyKey_Click"/>
                                    <MenuItem Header="刷新信息" Click="CtxRefresh_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="CtxPin" Header="置顶" Click="CtxTogglePin_Click"/>
                                    <MenuItem x:Name="CtxArchive" Header="归档" Click="CtxToggleArchive_Click"/>
                                    <MenuItem x:Name="CtxQianbao" Header="打开签报" Click="CtxOpenQianbao_Click"/>
                                    <MenuItem Header="删除" Click="CtxDelete_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel>
                                <!-- 第一行：Key + 类型 + 状态 + 操作按钮 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" FontFamily="Consolas" FontWeight="Bold"
                                               Foreground="#007AFF" Cursor="Hand" VerticalAlignment="Center"
                                               ToolTip="在浏览器中打开"
                                               MouseLeftButtonUp="RowKey_Click"/>
                                    <ctrl:StatusBadge Grid.Column="1" Margin="6,0,0,0"
                                                      Text="{Binding IssueType}"
                                                      BadgeColor="{Binding IssueTypeColorValue}"/>
                                    <ctrl:StatusBadge Grid.Column="2" Margin="6,0,0,0"
                                                      Text="{Binding Status}"
                                                      BadgeColor="{Binding StatusColorValue}"/>
                                    <TextBlock Grid.Column="3" Text="📌" FontSize="12" Margin="6,0,0,0"
                                               Foreground="#FF9500" VerticalAlignment="Center"
                                               Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource IconButton}" ToolTip="在浏览器中打开"
                                                Click="RowOpen_Click" Tag="{Binding}">🌐</Button>
                                        <Button Style="{StaticResource IconButton}" ToolTip="复制编号"
                                                Click="RowCopyKey_Click" Tag="{Binding}">📄</Button>
                                        <Button x:Name="RefreshBtn" Style="{StaticResource IconButton}" ToolTip="刷新信息"
                                                Click="RowRefresh_Click" Tag="{Binding}"
                                                Visibility="{Binding IsRefreshing, Converter={StaticResource InvBoolToVis}}">🔄</Button>
                                        <ProgressBar Width="16" Height="16" IsIndeterminate="True" Margin="5,0"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}"/>
                                        <Button Style="{StaticResource IconButton}" ToolTip="删除收藏"
                                                Click="RowDelete_Click" Tag="{Binding}">🗑</Button>
                                        <Button Style="{StaticResource IconButton}" ToolTip="置顶/取消置顶"
                                                Click="RowTogglePin_Click" Tag="{Binding}">
                                            <TextBlock x:Name="PinIcon" Text="📌" Opacity="0.4"/>
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" ToolTip="归档/取消归档"
                                                Click="RowToggleArchive_Click" Tag="{Binding}">🗄</Button>
                                    </StackPanel>
                                </Grid>
                                <!-- 第二行：标题（点击弹出详情） -->
                                <TextBlock Text="{Binding Summary}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           MaxHeight="36" Cursor="Hand" ToolTip="查看详情"
                                           MouseLeftButtonUp="RowSummary_Click"/>
                                <!-- 第三行：详情信息 + 签报号 -->
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock FontSize="12" Foreground="#888888">
                                        <Run Text="👤 "/><Run Text="{Binding Reporter, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#888888" Margin="12,0,0,0">
                                        <Run Text="👥 "/><Run Text="{Binding Assignee, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#888888" Margin="12,0,0,0"
                                               Visibility="{Binding Updated, Converter={StaticResource NonEmptyToVis}}">
                                        <Run Text="🕐 "/><Run Text="{Binding RelativeUpdated, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#007AFF" Margin="12,0,0,0" Cursor="Hand"
                                               ToolTip="打开签报"
                                               Visibility="{Binding QianbaoNo, Converter={StaticResource NonEmptyToVis}}"
                                               MouseLeftButtonUp="RowQianbao_Click">
                                        <Run Text="📄 "/><Run Text="{Binding QianbaoNo, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter Property="Background" Value="#17FF9500" TargetName="RowBorder"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter Property="Opacity" Value="1" TargetName="PinIcon"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
