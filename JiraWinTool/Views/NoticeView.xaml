<UserControl x:Class="JiraWinTool.Views.NoticeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:JiraWinTool.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <controls:PageHeader Title="通知生成" Subtitle="生成发布确认提醒文案或版本会议邀请通知" Icon="🔔"
                                 HeaderColor="#FF9500" Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="PublishModeRadio" Content="发布确认提醒" GroupName="Mode" IsChecked="True" Margin="0,0,16,0"/>
                <RadioButton x:Name="MeetingModeRadio" Content="版本会议通知" GroupName="Mode"/>
            </StackPanel>

            <controls:LabeledField Label="日期:" Placeholder="yyyy-MM-dd" x:Name="DateField"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="ExecuteButton" Content="生成" MinWidth="80" Height="30" Click="ExecuteButton_Click"/>
                <Button Content="复制" Height="30" Margin="12,0,0,0" Padding="10,0" Click="CopyButton_Click"/>
            </StackPanel>

            <controls:LogView x:Name="ResultLogView" MinHeight="220" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
