<Window x:Class="JiraWinTool.Views.JiraDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:JiraWinTool.Views.Controls"
        Title="Jira 详情" Width="720" Height="640" MinWidth="650" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#FAFAFA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Padding="16,12" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Background="#F5F5F5">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="KeyText" Text="" FontSize="20" FontWeight="Bold" Foreground="#007AFF"
                               Cursor="Hand" ToolTip="在浏览器中打开" VerticalAlignment="Center"
                               MouseLeftButtonUp="Key_Click"/>
                    <ctrl:StatusBadge x:Name="TypeBadge" Margin="10,0,0,0" VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                    <ctrl:StatusBadge x:Name="StatusBadge" Margin="6,0,0,0" VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🌐 浏览器打开" Padding="10,4" Margin="0,0,8,0" Click="OpenInBrowser_Click"/>
                    <Button Content="关闭" Padding="12,4" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区 -->
        <Grid Grid.Row="1">
            <!-- 加载中 -->
            <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="24" Height="24" IsIndeterminate="True"/>
                <TextBlock x:Name="LoadingText" Text="正在获取详情..." Foreground="#888888"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- 错误 -->
            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="⚠" FontSize="36" Foreground="#FF9500" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ErrorText" Text="" Foreground="Red" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,8,0,0" MaxWidth="500"/>
                <Button Content="重试" Width="80" Margin="0,12,0,0" Click="Retry_Click"/>
            </StackPanel>

            <!-- 详情 -->
            <ScrollViewer x:Name="DetailPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <!-- 标题 -->
                    <TextBlock x:Name="SummaryText" Text="" FontSize="18" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="4,0,4,12"/>

                    <!-- 基本信息 -->
                    <GroupBox Style="{StaticResource CardSection}" Header="🛈 基本信息">
                        <Grid x:Name="BasicInfoGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </GroupBox>

                    <!-- 标签 -->
                    <GroupBox x:Name="LabelsSection" Style="{StaticResource CardSection}" Header="🏷 标签"
                              Visibility="Collapsed">
                        <ItemsControl x:Name="LabelsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A007AFF" CornerRadius="4" Padding="8,3" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding}" FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <!-- 业务字段 -->
                    <GroupBox x:Name="CustomFieldsSection" Style="{StaticResource CardSection}" Header="📋 业务字段"
                              Visibility="Collapsed">
                        <Grid x:Name="CustomFieldsGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </GroupBox>

                    <!-- 签报信息 -->
                    <GroupBox x:Name="QianbaoSection" Style="{StaticResource CardSection}" Header="📄 签报信息"
                              Visibility="Collapsed">
                        <StackPanel>
                            <Grid x:Name="QianbaoNoRow" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="签报号:" FontSize="12" Foreground="#888888" Width="60"
                                           TextAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock x:Name="QianbaoNoText" Grid.Column="1" Margin="6,0,0,0"
                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid x:Name="QianbaoLinkRow">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="签报链接:" FontSize="12" Foreground="#888888" Width="60"
                                           TextAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock x:Name="QianbaoLinkText" Grid.Column="1" Margin="6,0,0,0"
                                           Foreground="#007AFF" Cursor="Hand" TextTrimming="CharacterEllipsis"
                                           MouseLeftButtonUp="QianbaoLink_Click"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- 价值描述 -->
                    <GroupBox x:Name="ValueDescSection" Style="{StaticResource CardSection}" Header="✨ 价值描述"
                              Visibility="Collapsed">
                        <TextBlock x:Name="ValueDescText" TextWrapping="Wrap"/>
                    </GroupBox>

                    <!-- 描述 -->
                    <GroupBox x:Name="DescSection" Style="{StaticResource CardSection}" Header="📄 申请原因及需求内容描述"
                              Visibility="Collapsed">
                        <TextBlock x:Name="DescText" TextWrapping="Wrap"/>
                    </GroupBox>

                    <!-- 最近评论 -->
                    <GroupBox x:Name="CommentsSection" Style="{StaticResource CardSection}" Header="💬 最近评论"
                              Visibility="Collapsed">
                        <ItemsControl x:Name="CommentsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F0F0F0" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Author}" FontSize="12"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Created}" FontSize="11"
                                                           Foreground="#888888" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Body}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                       MaxHeight="120"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <!-- 附件 -->
                    <GroupBox Style="{StaticResource CardSection}" Header="📎 附件" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="NoAttachmentText" Text="暂无附件" FontSize="12" Foreground="#888888"/>
                            <ItemsControl x:Name="AttachmentsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F0F0F0" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Icon}" FontSize="14" Width="22"
                                                           VerticalAlignment="Center" Foreground="#007AFF"/>
                                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Filename}" FontSize="13"
                                                                   Foreground="{Binding FilenameColor}"
                                                                   Cursor="{Binding FilenameCursor}"
                                                                   TextDecorations="{Binding FilenameDecoration}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Filename}"
                                                                   MouseLeftButtonUp="AttachmentFilename_Click"/>
                                                        <ProgressBar Width="14" Height="14" IsIndeterminate="True"
                                                                     Margin="6,0,0,0" VerticalAlignment="Center"
                                                                     Visibility="{Binding IsPreviewing, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding MetaText}" FontSize="11"
                                                               Foreground="#888888" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <ProgressBar Width="16" Height="16" IsIndeterminate="True"
                                                                 VerticalAlignment="Center"
                                                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                                                    <Button Style="{StaticResource IconButton}" ToolTip="下载到本地"
                                                            Click="AttachmentDownload_Click" Tag="{Binding}"
                                                            Visibility="{Binding IsBusy, Converter={StaticResource InvBoolToVis}}">⬇</Button>
                                                    <Button Style="{StaticResource IconButton}" ToolTip="在浏览器打开"
                                                            Click="AttachmentOpenUrl_Click" Tag="{Binding}"
                                                            Visibility="{Binding IsBusy, Converter={StaticResource InvBoolToVis}}">🌐</Button>
                                                    <Button Style="{StaticResource IconButton}" ToolTip="删除附件"
                                                            Foreground="Red"
                                                            Click="AttachmentDelete_Click" Tag="{Binding}"
                                                            Visibility="{Binding IsBusy, Converter={StaticResource InvBoolToVis}}">🗑</Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 上传区：拖拽 / 选择 / 粘贴 -->
                            <Border x:Name="DropZone" Margin="0,4,0,0" Padding="8,14" CornerRadius="8"
                                    Background="#66F0F0F0" BorderBrush="#4D888888" BorderThickness="1.5"
                                    AllowDrop="True"
                                    DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave"
                                    Drop="DropZone_Drop">
                                <StackPanel>
                                    <StackPanel x:Name="DropHintPanel">
                                        <TextBlock Text="⬇" FontSize="18" Foreground="#888888"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="拖拽文件到此处上传，或点击下方按钮（Ctrl+V 粘贴）" FontSize="12"
                                                   Foreground="#888888" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                    Margin="0,8,0,0">
                                            <Button Content="📁 选择文件" Padding="10,3" Margin="0,0,8,0"
                                                    Click="ChooseFile_Click"/>
                                            <Button Content="📋 粘贴" Padding="10,3" Click="Paste_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel x:Name="UploadingPanel" Visibility="Collapsed"
                                                Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ProgressBar Width="16" Height="16" IsIndeterminate="True"/>
                                        <TextBlock Text="正在上传..." FontSize="12" Foreground="#888888"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="UploadMessageText" Margin="0,8,0,0" FontSize="12"
                                       TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
